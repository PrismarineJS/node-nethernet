{
  "name": "nethernet",
  "version": "1.1.2",
  "description": "Library for the Minecraft Bedrock nethernet protocol",
  "main": "index.js",
  "scripts": {
    "test": "mocha --reporter spec",
    "pretest": "npm run lint && npm run typecheck",
