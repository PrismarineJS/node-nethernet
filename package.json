    "fix": "standard --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PrismarineJS/node-nethernet.git"
  },
  "keywords": [
    "prismarine",
    "template"
  ],
  "author": "Romain Beaumont",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/PrismarineJS/node-nethernet/issues"
  },
  "homepage": "https://github.com/PrismarineJS/node-nethernet#readme",
  "devDependencies": {
    "@roamhq/wrtc": "^0.10.0",
    "@types/node": "^24.13.6",
    "debug": "^4.4.0",
    "mocha": "^11.7.5",
    "nethernet": "file:.",
    "standard": "^17.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.3",
    "protodef": "^1.19.0",
    "werift": "0.24.4"
  },
